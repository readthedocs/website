// Because h1.ui.medium.header is still sized as an h1
.ui.medium.header {
  font-size: @mediumFontSize;
}

/* Header after a divider header */
.ui.header.divider + .ui.header {
  margin-top: e(%("calc(-1rem + %d)", @headerLineHeightOffset));
}

/* Treat a header in a center aligned column as a block */
.ui.grid,
.ui.grid > .row {
  & > .center.aligned.column .ui.inline.header {
    text-align: left;
    display: inline-block;
  }
}

/* Accent header: a short colored bar under a section heading */
.ui.ui.accent.header {
  margin-bottom: 2rem;

  &::after {
    content: "";
    display: block;
    width: 3rem;
    height: 0.25rem;
    margin-top: 0.75rem;
    border-radius: 0.125rem;
    background-color: @primaryColor;
  }
  &.center.aligned::after {
    margin-left: auto;
    margin-right: auto;
  }
}
.ui.ui.teal.accent.header {
  color: @textColor;
  &::after {
    background-color: @teal;
  }
}
.ui.ui.violet.accent.header {
  color: @textColor;
  &::after {
    background-color: @violet;
  }
}
