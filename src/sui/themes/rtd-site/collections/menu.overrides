// Vertically center an item's icon, for items with more than one line
.ui.vertical.menu .item > i.middle.aligned.icon {
  position: absolute;
  top: 50%;
  right: @itemHorizontalPadding;
  transform: translateY(-50%);
  float: none;
  margin: 0;
}

// Keep menu items readable in a popup opened from centered content
.ui.popup > .ui.vertical.menu .item {
  text-align: left;
}
